{
  "name": "textfold-cloudflare-storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types --include-runtime=false",
    "check": "npm run types && tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir .wrangler/build",
    "test": "npm run check && npm run build && node --test test/*.test.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "miniflare": "^5.20261019.2-beta",
    "typescript": "^7.0.2",
    "wrangler": "^4.152.0"
  }
}
