{
  "name": "textfold-desktop",
  "private": true,
  "version": "0.10.42",
  "description": "TextFold as an app: the local server and the reader in one window",
  "license": "Apache-2.0",
  "author": "Xia Chen",
  "repository": "github:chenxiachan/textfold",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test links.test.js",
    "payload": "node scripts/prepare-payload.mjs",
    "dist:mac": "node scripts/prepare-payload.mjs darwin arm64 && electron-builder --mac dmg zip --arm64 --publish never",
    "dist:mac:x64": "node scripts/prepare-payload.mjs darwin x64 && electron-builder --mac dmg zip --x64 --publish never",
    "dist:win": "node scripts/prepare-payload.mjs win32 x64 && electron-builder --win nsis --x64 --publish never",
    "pack:mac": "npm run payload && electron-builder --mac dir --publish never -c.mac.identity=null -c.mac.notarize=false"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.chenxiachan.textfold",
    "productName": "TextFold",
    "icon": "build/icon.png",
    "directories": {
      "output": "out"
    },
    "files": [
      "main.js",
      "links.js",
      "preload.js",
      "splash.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "payload",
        "to": "payload"
      }
    ],
    "protocols": [
      {
        "name": "TextFold link",
        "schemes": [
          "textfold"
        ],
        "role": "Viewer"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "extendInfo": {
        "CFBundleIconName": "Icon"
      },
      "extraResources": [
        {
          "from": "build/Assets.car",
          "to": "Assets.car"
        }
      ],
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "npmRebuild": false,
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-win-${arch}-setup.${ext}",
      "shortcutName": "TextFold",
      "uninstallDisplayName": "TextFold"
    },
    "publish": {
      "provider": "github",
      "owner": "chenxiachan",
      "repo": "textfold"
    },
    "dmg": {
      "artifactName": "${productName}-mac-${arch}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
